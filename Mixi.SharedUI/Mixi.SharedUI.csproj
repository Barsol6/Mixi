<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <UseMaui>true</UseMaui>

        <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>

        <UserSecretsId>515e496b-168c-4cb9-8ba7-5301fe039e5d</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.14"/>
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Components\Layout\BaseLayout.razor"/>
        <AdditionalFiles Include="Components\Layout\Footer.razor"/>
        <AdditionalFiles Include="Components\Layout\LoginLayout.razor"/>
        <AdditionalFiles Include="Components\Layout\MainLayout.razor"/>
        <AdditionalFiles Include="Components\Layout\MenuLayout.razor"/>
        <AdditionalFiles Include="Components\Layout\NavMenu.razor"/>
        <AdditionalFiles Include="Components\Layout\PdfViewerLayout.razor"/>
        <AdditionalFiles Include="Components\Layout\SectionLayout.razor"/>
        <AdditionalFiles Include="Components\Pages\Error.razor"/>
        <AdditionalFiles Include="Components\Pages\Index.razor"/>
        <AdditionalFiles Include="Components\Pages\LoginPage.razor"/>
        <AdditionalFiles Include="Components\Pages\Menu.razor"/>
        <AdditionalFiles Include="Components\Pages\Pdf\PdfViewer.razor"/>
        <AdditionalFiles Include="Components\Pages\Pdf\UploadPdf.razor"/>
        <AdditionalFiles Include="Components\UI\MenuPopupContainer.razor"/>
        <AdditionalFiles Include="Components\UI\PdfPopupContainer.razor"/>
        <AdditionalFiles Include="Components\UI\PopupContainer.razor"/>
    </ItemGroup>

    <ItemGroup> 
        <ProjectReference Include="..\Mixi.Shared.Models\Mixi.Shared.Models.csproj"/>
    </ItemGroup>

    <Target Name="NpmInstall" BeforeTargets="CopyPdfJsFiles">
        <Exec Command="npm install" WorkingDirectory="$(ProjectDir)"/>
    </Target>

    <Target Name="CopyPdfJsFiles" BeforeTargets="Build">
        <Message Text="--- Copying and renaming PDF.js v4 module files (.mjs to .js)... ---" Importance="high"/>
        <MakeDir Directories="wwwroot/js/pdfjs/web"/>

        <ItemGroup>
            <PdfJsCoreMjs Include="..\node_modules\pdfjs-dist\build\pdf.mjs;..\node_modules\pdfjs-dist\build\pdf.worker.mjs"/>
            <PdfJsViewerMjs Include="..\node_modules\pdfjs-dist\web\pdf_viewer.mjs"/>

            <PdfJsViewerCss Include="..\node_modules\pdfjs-dist\web\pdf_viewer.css"/>
        </ItemGroup>

        <ItemGroup>
            <Content Include="wwwroot\css\source.css" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>

        <Copy SourceFiles="@(PdfJsCoreMjs)"
              DestinationFiles="@(PdfJsCoreMjs->'wwwroot\js\pdfjs\%(Filename).js')" />

        <Copy SourceFiles="@(PdfJsViewerMjs)"
              DestinationFiles="@(PdfJsViewerMjs->'wwwroot\js\pdfjs\web\%(Filename).js')" />

        <Copy SourceFiles="@(PdfJsViewerCss)"
              DestinationFolder="wwwroot/js/pdfjs\web\"/>

        <Message Text="--- PDF.js file copy and conversion complete. ---" Importance="high"/>
    </Target>

    <Target Name="CopyHowlerJs" BeforeTargets="Build" AfterTargets="CopyPdfJsFiles">
        <Message Text="--- Copying Howler.js module files... ---" Importance="high"/>
        <Makedir Directories="wwwroot/js/howlerjs"/>

        <ItemGroup>
            <HowlerJs Include="..\node_modules\howler\dist\howler.min.js"/>
        </ItemGroup>

        <Copy SourceFiles="@(HowlerJs)" DestinationFolder="wwwroot/js/howlerjs"/>
        <Message Text="---  Howler.js download finished. ---" Importance="high"/>
    </Target>
    

    
</Project>
